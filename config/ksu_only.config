# KSU-Next only (no SUSFS). First-known-good build.
CONFIG_KSU=y

# Don't build the per-project DTB OVERLAYS (oplus6765_21331 etc). Their per-project
# cust.dtsi are generated by Oppo's Android build and are absent in a standalone kernel
# build, so dtc fails on them. We flash only boot (block=boot) with the base
# mediatek/mt6765 appended dtb; the dtbo partition stays stock, so the overlays are
# not needed for this build.
# CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE is not set
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES=""

# Do NOT enforce module signatures. The stock defconfig sets MODULE_SIG_FORCE=y with
# MODULE_SIG_KEY="certs/signing_key.pem"; our CI generates its OWN signing key, so an
# enforcing kernel rejects the stock-signed vendor modules (wlan_drv_gen4m, wmt_drv,
# bt_drv_connac1x, gps_drv, fmradio_drv_mt6631, connfem, ...) with "Required key not
# available", killing WiFi/BT/GPS/FM. Turn enforcement off and don't auto-sign our build,
# so the stock vendor .ko load (tainted, which is fine). MODULE_SIG=y may stay as long as
# FORCE is off; if FORCE is re-selected, the CI .config check will fail the build and we
# disable MODULE_SIG entirely.
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
